{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDirs": ["react", "vitest/react", "storybook/react"]
  },
  "include": [
    "typecheck-shims.d.ts",
    "playwright/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx",
    "vitest/**/*.ts",
    "vitest/**/*.tsx",
    "storybook/**/*.ts",
    "storybook/**/*.tsx"
  ]
}
